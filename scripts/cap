#!/usr/bin/env bash
# cap: low-friction capture for a hardware bring-up or rebuild log.
# Every artifact lands under $CAP_ROOT (default: ./capture). Treat it as private: snapshots
# include kernel logs, device lists and the kernel command line.
# Nothing here changes system state; snap uses sudo -n only for the kernel log and skips it otherwise.
#
#   cap init                          create capture tree and timeline
#   cap phase <name> [who] [at]       timeline mark; who = me|agent|wait (default me); at = backfill time
#   cap note <text...>                free-text line in the timeline
#   cap snap <label> [note...]        system-state snapshot + expected/observed note (the "surprise log")
#   cap rec <name> [-- cmd...]        asciinema recording (interactive, or of one command)
#   cap run <name> -- cmd...          headless capture for agent-run commands (output + timing + exit)
#   cap log <name>                    text-only recorded shell (script(1)); for steps that don't need a cast
#   cap time <name> -- cmd...         benchmark: wall time, exit code, battery energy delta
#   cap matrix <file>                 snapshot a status file (e.g. a hardware matrix)
#   cap gif <name>                    render casts/<name>.cast to GIF with agg
set -euo pipefail

CAP_ROOT="${CAP_ROOT:-$PWD/capture}"
TL="$CAP_ROOT/timeline.tsv"
now() { date --iso-8601=seconds; }
slug() { tr -cs 'A-Za-z0-9._-' '-' <<<"$1" | sed 's/^-//; s/-$//'; }
need_init() { [ -f "$TL" ] || { echo "run: cap init" >&2; exit 1; }; }
mark() { printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" >>"$TL"; }
battery_wh() {
  local f
  for f in /sys/class/power_supply/*/energy_now; do
    [ -r "$f" ] && { awk '{printf "%.2f", $1/1e6}' "$f"; return; }
  done
  echo NA
}
on_ac() { grep -qsx 1 /sys/class/power_supply/*/online && echo ac || echo battery; }

cmd="${1:-help}"; shift || true
case "$cmd" in
  init)
    mkdir -p "$CAP_ROOT"/{casts,runs,snaps,matrix,gifs}
    [ -f "$TL" ] || printf 'time\tkind\twho\twhat\n' >"$TL"
    mark "$(now)" init me "kernel $(uname -r)"
    echo "capture root: $CAP_ROOT"
    ;;
  phase)
    need_init
    [ $# -ge 1 ] || { echo "cap phase <name> [me|agent|wait] [time]" >&2; exit 2; }
    at="${3:+$(date --iso-8601=seconds -d "$3")}"
    mark "${at:-$(now)}" phase "${2:-me}" "$1"
    ;;
  note)
    need_init; mark "$(now)" note me "$*"
    ;;
  snap)
    need_init
    label="$(slug "${1:-snap}")"; d="$CAP_ROOT/snaps/$(date +%Y%m%dT%H%M%S)-$label"; mkdir -p "$d"
    shift || true
    why="$*"
    if [ -z "$why" ] && [ -t 0 ]; then read -r -p "expected / observed (one line): " why || why=""; fi
    {
      echo "label: $label"; echo "note: $why"; echo "time: $(now)"; uname -a
      grep -E '^(PRETTY_NAME|VERSION_ID)=' /etc/os-release
      cat /proc/cmdline; echo "power: $(on_ac) $(battery_wh) Wh"
    } >"$d/summary.txt"
    lsmod >"$d/lsmod.txt" 2>&1 || true
    cat /proc/bus/input/devices >"$d/input-devices.txt" 2>&1 || true
    ls -l /sys/bus/i2c/devices/ >"$d/i2c-devices.txt" 2>&1 || true
    tr -d '\0' </proc/device-tree/compatible >"$d/dt-compatible.txt" 2>/dev/null || true
    # shellcheck disable=SC2024  # output file is ours; sudo only needs to read the ring buffer
    journalctl -k -b --no-pager >"$d/kernel.txt" 2>/dev/null || sudo -n dmesg >"$d/kernel.txt" 2>/dev/null || echo "no kernel log access" >"$d/kernel.txt"
    grep -iE 'firmware|direct firmware|failed|error|-110|-61|ENXIO' "$d/kernel.txt" >"$d/kernel-problems.txt" || true
    { wpctl status 2>/dev/null || pactl list short sinks sources 2>/dev/null; } >"$d/audio.txt" || true
    { command -v glxinfo >/dev/null && glxinfo -B; } >"$d/gpu.txt" 2>&1 || true
    mark "$(now)" snap me "$label: $why"
    echo "$d"
    ;;
  rec)
    need_init
    command -v asciinema >/dev/null || { echo "asciinema not installed" >&2; exit 1; }
    name="$(slug "$1")"; shift
    [ "${1:-}" = "--" ] && shift
    out="$CAP_ROOT/casts/$(date +%Y%m%dT%H%M%S)-$name.cast"
    mark "$(now)" rec me "$name start"
    args=(rec --idle-time-limit 2 --title "$name")
    [ $# -gt 0 ] && args+=(--command "$(printf '%q ' "$@")")
    PS1='$ ' asciinema "${args[@]}" "$out"
    mark "$(now)" rec me "$name end -> $(basename "$out")"
    ;;
  run)
    need_init
    name="$(slug "$1")"; shift; [ "${1:-}" = "--" ] && shift
    [ $# -gt 0 ] || { echo "cap run <name> -- cmd..." >&2; exit 2; }
    base="$CAP_ROOT/runs/$(date +%Y%m%dT%H%M%S)-$name"
    printf '%q ' "$@" >"$base.cmd"
    mark "$(now)" run agent "$name start"
    set +e
    script -q -e -T "$base.timing" -O "$base.log" -c "$(cat "$base.cmd")"
    rc=$?
    set -e
    mark "$(now)" run agent "$name exit=$rc"
    exit "$rc"
    ;;
  log)
    need_init
    name="$(slug "$1")"
    base="$CAP_ROOT/runs/$(date +%Y%m%dT%H%M%S)-$name"
    mark "$(now)" log me "$name start"
    set +e
    script -q -T "$base.timing" -O "$base.log" -c "${SHELL:-bash}"
    set -e
    mark "$(now)" log me "$name end -> $(basename "$base").log"
    ;;
  time)
    need_init
    name="$(slug "$1")"; shift; [ "${1:-}" = "--" ] && shift
    e0="$(battery_wh)"; p="$(on_ac)"; t0="$(date +%s.%N)"
    set +e; "$@"; rc=$?; set -e
    t1="$(date +%s.%N)"; e1="$(battery_wh)"
    secs="$(awk -v a="$t0" -v b="$t1" 'BEGIN{printf "%.1f", b-a}')"
    line="$(uname -m)	$name	${secs}s	exit=$rc	$p	${e0}->${e1}Wh"
    printf '%s\t%s\n' "$(now)" "$line" >>"$CAP_ROOT/bench.tsv"
    mark "$(now)" bench me "$name ${secs}s exit=$rc"
    echo "$line"; exit "$rc"
    ;;
  matrix)
    need_init
    [ -f "${1:-}" ] || { echo "cap matrix <file>" >&2; exit 2; }
    cp "$1" "$CAP_ROOT/matrix/$(date +%Y%m%dT%H%M%S)-$(basename "$1")"
    mark "$(now)" matrix me "snapshot $(basename "$1")"
    ;;
  gif)
    command -v agg >/dev/null || { echo "agg not installed" >&2; exit 1; }
    casts=("$CAP_ROOT"/casts/*"$(slug "$1")".cast); src="${casts[-1]}"
    [ -f "$src" ] || { echo "no cast matching $1" >&2; exit 1; }
    agg --idle-time-limit 2 "$src" "$CAP_ROOT/gifs/$(basename "${src%.cast}").gif"
    ;;
  help|*)
    sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
